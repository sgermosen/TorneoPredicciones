@model IEnumerable<CompeTournament.Backend.Data.Entities.Group>
@{
    ViewData["Title"] = "Torneos";
    var isAdmin = User.IsInRole("Admin");
}

<h1>Torneos</h1>
<br />
@if (isAdmin)
{
    <p>
        <a class="btn btn-primary" asp-action="Create">
            <span class="fa fa-plus"></span>
            Crear torneo
        </a>
    </p>
}
@if (@Model.Count() > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    Nombre
                </th>
                <th>
                    Tipo
                </th>
                <th>
                    Requisitos
                </th>
                <th>
                    Miembros
                </th>
                <th>

                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TournamentType.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Requirements)
                    </td>
                    <td>
                        @item.GroupUsers.Count(gu => gu.IsAccepted && !gu.IsBlocked)
                    </td>
                    <td>

                        @{
                            var ugroup = item.GroupUsers.Where(p => p.ApplicationUser?.Email == User.Identity.Name).FirstOrDefault();

                            if (isAdmin || item.CreatedUser?.Email == User.Identity.Name || (ugroup != null && ugroup.IsAccepted && !ugroup.IsBlocked))
                            {
                                <a class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">
                                    Entrar al torneo
                                </a>
                            }
                            else if (ugroup == null)
                            {
                                <form asp-action="JoinRequest" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-success">Solicitar ingreso</button>
                                </form>
                            }
                            else if (ugroup.IsBlocked)
                            {
                                <div>
                                    Ya no eres parte de este torneo.
                                </div>
                            }
                            else
                            {
                                <div>
                                    Tu solicitud está pendiente de aprobación.
                                </div>
                            }
                        }

                    </td>
                </tr>

            }

        </tbody>
    </table>
}
else
{
    <div>Todavía no hay torneos.</div>
}
