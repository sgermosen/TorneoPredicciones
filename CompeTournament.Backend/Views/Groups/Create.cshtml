@model CompeTournament.Backend.Data.Entities.Group
@{
    ViewData["Title"] = "Crear torneo";
}

<h1>Crear torneo</h1>

<form asp-action="Create">
    <div class="form-group">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row">
            <div class="col-md-2">
                <label asp-for="Name" class="control-label">Nombre</label>
            </div>
            <div class="col-md-4">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2">
                <label asp-for="Requirements" class="control-label">Descripción</label>
            </div>
            <div class="col-md-4">
                <textarea asp-for="Requirements" class="form-control"></textarea>
                <span asp-validation-for="Requirements" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2">
                <label asp-for="TournamentTypeId" class="control-label">Tipo de torneo</label>
            </div>
            <div class="col-md-4">
                <select asp-for="TournamentTypeId" class="form-control" asp-items="ViewBag.TournamentTypeId"></select>
                <span asp-validation-for="TournamentTypeId" class="text-danger"></span>
            </div>
        </div>
        <br /><br />
        <div class="row">
            <div class="col-md-2">
            </div>
            <div class="col-md-5">
                <button type="submit" class="btn btn-primary">Crear torneo</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </div>
    </div>
</form>
