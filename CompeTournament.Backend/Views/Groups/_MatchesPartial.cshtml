@model IEnumerable<CompeTournament.Backend.Data.Entities.Match>
@using CompeTournament.Backend.Helpers
@inject TimeZoneInfo TournamentZone
@{
    var isAdmin = User.IsInRole("Admin");
    var isMember = ViewData["IsMember"] as bool? == true;
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<h2>Partidos</h2>
@if (isAdmin)
{
    <p>
        <a class="btn btn-primary" asp-action="CreateMatch" asp-route-id="@ViewData["GroupId"]">Agregar partido</a>
    </p>
}
@if (Model.Count() == 0)
{
    <div>Este torneo todavía no tiene partidos.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Local</th>
                <th>Visitante</th>
                <th>Estado</th>
                <th>Resultado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderBy(m => m.DateTime))
            {
                var mine = item.Predictions?.FirstOrDefault(p => p.CreatedBy == userId);
                <tr>
                    <td>@item.DateTime.ToTournamentTime(TournamentZone).ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Local?.Name</td>
                    <td>@item.Visitor?.Name</td>
                    <td>@item.Status?.Name</td>
                    <td>@(item.LocalPoints.HasValue && item.VisitorPoints.HasValue ? $"{item.LocalPoints} - {item.VisitorPoints}" : string.Empty)</td>
                    <td>
                        @if (mine != null)
                        {
                            <div>Tu predicción: @mine.LocalPoints - @mine.VisitorPoints</div>
                        }
                        @if (isMember && item.StatusId == 1)
                        {
                            <a class="btn btn-primary btn-sm" asp-action="MakePrediction" asp-route-id="@item.Id">@(mine == null ? "Predecir" : "Cambiar predicción")</a>
                        }
                        @if (isAdmin && item.StatusId != 3)
                        {
                            <a class="btn btn-warning btn-sm" asp-action="CloseMatch" asp-route-id="@item.Id">Cerrar partido</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
