@model CompeTournament.Backend.Data.Entities.Team
@{
    ViewData["Title"] = "Agregar equipo";
}

<h1>Agregar equipo</h1>

<form asp-action="CreateTeam">
    <input type="hidden" asp-for="LeagueId" />
    <div class="form-group">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row">
            <div class="col-md-2">
                <label asp-for="Name" class="control-label">Nombre</label>
            </div>
            <div class="col-md-4">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2">
                <label asp-for="Initials" class="control-label">Siglas</label>
            </div>
            <div class="col-md-4">
                <input asp-for="Initials" class="form-control" maxlength="4" placeholder="Ej.: TIG" />
                <span asp-validation-for="Initials" class="text-danger"></span>
            </div>
        </div>
        <br /><br />
        <div class="row">
            <div class="col-md-2">
            </div>
            <div class="col-md-5">
                <button type="submit" class="btn btn-primary">Agregar equipo</button>
                <a class="btn btn-outline-secondary" asp-action="DetailsLeague" asp-route-id="@Model.LeagueId">Cancelar</a>
            </div>
        </div>
    </div>
</form>
