@model CompeTournament.Backend.Data.Entities.League
@{
    ViewData["Title"] = Model.Name;
    var isAdmin = User.IsInRole("Admin");
}

<p>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.GroupId">Volver al torneo</a>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="CreateTeam" asp-route-id="@Model.Id">Agregar equipo</a>
    }
</p>

<h1>@Model.Name</h1>

@if (Model.Teams.Count() == 0)
{
    <div>Esta liga todavía no tiene equipos.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Equipo</th>
                <th>Siglas</th>
                <th>Jugados</th>
                <th>Ganados</th>
                <th>Empatados</th>
                <th>Perdidos</th>
                <th>Puntos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Teams.OrderByDescending(t => t.CumulativePoints ?? 0).ThenBy(t => t.Name))
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Initials</td>
                    <td>@(item.MatchesPlayed ?? 0)</td>
                    <td>@(item.MatchesWon ?? 0)</td>
                    <td>@(item.MatchesTied ?? 0)</td>
                    <td>@(item.MatchesLost ?? 0)</td>
                    <td>@(item.CumulativePoints ?? 0)</td>
                </tr>
            }
        </tbody>
    </table>
}
