@model IEnumerable<CompeTournament.Backend.Data.Entities.GroupUser>
@using CompeTournament.Backend.Helpers
@inject TimeZoneInfo TournamentZone
@{
    var isAdmin = User.IsInRole("Admin");
}

<h2>Miembros</h2>

@if (Model.Count() == 0)
{
    <div>Este torneo todavía no tiene miembros. Comparte el código de invitación con tus amigos.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Desde</th>
                <th>Puntos</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderByDescending(m => m.Points))
            {
                <tr>
                    <td>@item.ApplicationUser?.FullName</td>
                    <td>@(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToTournamentTime(TournamentZone).ToString("dd/MM/yyyy") : string.Empty)</td>
                    <td>@item.Points</td>
                    <td>@(item.IsBlocked ? "Retirado" : item.IsAccepted ? "Miembro" : "Pendiente")</td>
                    <td>
                        @if (isAdmin && !item.IsBlocked && item.ApplicationUser?.Email != User.Identity.Name)
                        {
                            if (item.IsAccepted)
                            {
                                <form asp-action="FireFromGroup" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm">Retirar del torneo</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="AcceptRequestJoin" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-success btn-sm">Aceptar</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
