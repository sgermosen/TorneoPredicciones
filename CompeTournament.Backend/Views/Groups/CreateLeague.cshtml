@model CompeTournament.Backend.Data.Entities.League
@{
    ViewData["Title"] = "Agregar liga";
}

<h1>Agregar liga</h1>

<form asp-action="CreateLeague">
    <input type="hidden" asp-for="GroupId" />
    <div class="form-group">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row">
            <div class="col-md-2">
                <label asp-for="Name" class="control-label">Nombre</label>
            </div>
            <div class="col-md-4">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <br /><br />
        <div class="row">
            <div class="col-md-2">
            </div>
            <div class="col-md-5">
                <button type="submit" class="btn btn-primary">Agregar liga</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.GroupId">Cancelar</a>
            </div>
        </div>
    </div>
</form>
