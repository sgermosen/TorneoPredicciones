@model CompeTournament.Backend.Data.Entities.Group
@{
    ViewData["Title"] = Model.Name;
    ViewData["GroupId"] = Model.Id;
    ViewData["IsMember"] = Model.GroupUsers.Any(gu => gu.ApplicationUser?.Email == User.Identity.Name && gu.IsAccepted && !gu.IsBlocked);
    var isAdmin = User.IsInRole("Admin");
}

<p>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver a los torneos</a>
</p>

<h1>@Model.Name</h1>
<p class="text-muted">@Model.TournamentType?.Name</p>
@if (!string.IsNullOrWhiteSpace(Model.Requirements))
{
    <p>@Model.Requirements</p>
}
@if (isAdmin && !string.IsNullOrWhiteSpace(Model.InviteCode))
{
    <p>Código de invitación: <strong>@Model.InviteCode</strong></p>
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div id="tableHolder">
    <partial name="_LeaguesPartial" model="Model.Leagues" />
</div>

<div id="tableHolder">
    <partial name="_MatchesPartial" model="Model.Matches" />
</div>

<div id="tableHolder">
    <partial name="_MembersPartial" model="Model.GroupUsers" />
</div>
