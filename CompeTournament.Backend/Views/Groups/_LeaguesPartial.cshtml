@model IEnumerable<CompeTournament.Backend.Data.Entities.League>
@{
    var isAdmin = User.IsInRole("Admin");
}

<h2>Ligas</h2>
@if (isAdmin)
{
    <p>
        <a class="btn btn-primary" asp-action="CreateLeague" asp-route-id="@ViewData["GroupId"]">Agregar liga</a>
    </p>
}
@if (Model.Count() == 0)
{
    <div>Este torneo todavía no tiene ligas.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>
                        <a class="btn btn-info btn-sm" asp-action="DetailsLeague" asp-route-id="@item.Id">Ver equipos</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
