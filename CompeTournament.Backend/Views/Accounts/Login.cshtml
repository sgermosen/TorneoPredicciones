@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}


<div class="block-center mt-4 wd-xl">
    <!-- START card-->
    <div class="card card-flat">
        <div class="card-body">
            <h1 class="h3 text-center">Copa Amistosa</h1>
            <p class="text-center py-2">Inicia sesión para continuar</p>
            <form class="mb-3" id="loginForm" novalidate="novalidate" method="post">
                <div asp-validation-summary="ModelOnly"></div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input class="form-control border-right-0"
                               id="exampleInputEmail1" type="email"
                               placeholder="Correo electrónico"
                               autocomplete="off" required="required"
                               asp-for="Username" />
                        <div class="input-group-append">
                            <span class="input-group-text text-muted bg-transparent border-left-0">
                                <em class="fa fa-envelope"></em>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="input-group with-focus">
                        <input class="form-control border-right-0"
                               id="exampleInputPassword1"
                               type="password" placeholder="Contraseña"
                               required="required"
                               asp-for="Password" />
                        <div class="input-group-append">
                            <span class="input-group-text text-muted bg-transparent border-left-0">
                                <em class="fa fa-lock"></em>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="clearfix">
                    <div class="checkbox c-checkbox float-left mt-0">
                        <label>
                            <input type="checkbox" asp-for="RememberMe" />
                            <span class="fa fa-check"></span>Recordarme en este equipo
                        </label>
                    </div>
                    <div class="float-right">
                        <a class="text-muted"
                           asp-action="RecoverPassword">¿Olvidaste tu contraseña?</a>
                    </div>
                </div>
                <button class="btn btn-block btn-primary mt-3" type="submit">Entrar</button>
            </form>
             <p class="pt-3 text-center">¿No tienes cuenta?</p>
                <a class="btn btn-block btn-secondary" asp-action="Register">Registrarme ahora</a>
        </div>
    </div>
    <!-- END card-->
    <div class="p-3 text-center">
        <span class="mr-2">&copy;</span>
        <span>2026 Copa Amistosa</span>
        <br />
        <span>Predicciones amistosas entre amigos</span>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

