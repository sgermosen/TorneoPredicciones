@model ErrorViewModel
@{
    var notFound = ViewData["StatusCode"] as int? == 404;
    ViewData["Title"] = notFound ? "Página no encontrada" : "Error";
}

@if (notFound)
{
    <h1>Página no encontrada</h1>
    <p>La página que buscas no existe o cambió de lugar.</p>
}
else
{
    <h1 class="text-danger">Ocurrió un error</h1>
    <p>No pudimos completar tu solicitud. Intenta de nuevo en unos minutos.</p>
    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Referencia:</strong> <code>@Model.RequestId</code>
        </p>
    }
}
<p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</p>
